# Agents default to deterministic offline mode. Benchmark uses --live explicitly.
LAB_MODE=offline
STATE_DIR=state
COMPACT_THRESHOLD_TOKENS=1200
COMPACT_KEEP_MESSAGES=6
PROFILE_CONFIDENCE_THRESHOLD=0.85

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
OPENAI_API_KEY=

# Judge inherits the main model unless overridden; only --live --judge uses it.
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-2.5-flash
# JUDGE_API_KEY=

# Alternative providers:
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_BASE_URL=
